{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "e2e/**/*.spec.ts"
      ]
    },
    "packages/*": {
      "entry": [
        "src/react/index.ts",
        "src/manifest.ts",
        "scripts/*.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "apps/catalog": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "tools/*": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "tools/lumin": {
      "entry": [
        "src/cli.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "tools/scene-emit": {
      "entry": [
        "test/*.test.ts"
      ],
      "project": [
        "test/**/*.ts"
      ],
      "ignoreDependencies": [
        "@hedronite/lts-adapters",
        "@hedronite/lts-materials",
        "@hedronite/lts-objects",
        "@hedronite/lts-postfx",
        "@hedronite/lts-primitives",
        "@hedronite/lts-shaders",
        "@hedronite/lts-tokens"
      ]
    },
    "apps/site": {
      "entry": [
        "src/**/*.astro",
        "src/**/*.ts"
      ],
      "project": [
        "src/**/*.{astro,ts}"
      ],
      "ignoreDependencies": [
        "@hedronite/lts-tokens",
        "tailwindcss"
      ]
    }
  },
  "ignoreBinaries": [
    "nu"
  ],
  "ignore": [
    "assets/vendor/**",
    "e2e/scenes/generated/**"
  ]
}
